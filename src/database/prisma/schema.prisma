generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  ADMIN
  USER
}

model Usuario {
  id            String    @id @default(uuid()) @db.Uuid
  cedula        String    @unique @db.VarChar(10)
  nombre        String    @db.VarChar(150)
  email         String    @unique @db.VarChar(255)
  passwordHash  String    @map("password_hash") @db.VarChar(255)
  rol           Rol       @default(USER)
  activo        Boolean   @default(true)
  ultimoAcceso  DateTime? @map("ultimo_acceso") @db.Timestamptz()
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz()

  registros     Registro[]
  refreshTokens RefreshToken[]

  @@index([deletedAt], map: "idx_usuarios_deleted_at")
  @@map("usuarios")
}

model Registro {
  id            String   @id @default(uuid()) @db.Uuid
  usuarioId     String   @map("usuario_id") @db.Uuid
  pozo          String   @db.VarChar(100)
  operador      String   @db.VarChar(150)
  fecha         DateTime @db.Date
  presionCabeza Decimal  @map("presion_cabeza") @db.Decimal(12, 2)
  presionAnular Decimal  @map("presion_anular") @db.Decimal(12, 2)
  velocidad     Decimal  @db.Decimal(12, 2)
  corriente     Decimal  @db.Decimal(12, 2)
  torque        Decimal  @db.Decimal(12, 2)
  cargaPozo     Decimal  @map("carga_pozo") @db.Decimal(12, 2)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz()

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([usuarioId], map: "idx_registros_usuario_id")
  @@index([pozo], map: "idx_registros_pozo")
  @@index([fecha], map: "idx_registros_fecha")
  @@index([pozo, fecha(sort: Desc)], map: "idx_registros_pozo_fecha")
  @@index([deletedAt], map: "idx_registros_deleted_at")
  @@map("registros")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  usuarioId String   @map("usuario_id") @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime @map("expires_at") @db.Timestamptz()
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([usuarioId, revoked], map: "idx_refresh_tokens_usuario_revocado")
  @@index([expiresAt], map: "idx_refresh_tokens_expira")
  @@map("refresh_tokens")
}
